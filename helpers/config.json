{
  "schema_version": 2,
  "target_count": 100,
  "top_table_size": 30,
  "min_stars": 20000,

  "fetch": {
    "floor_fraction": 0.9,
    "max_repo_search_pages": 3,
    "per_query_page_size": 50,
    "graphql_batch_size": 50
  },

  "render": {
    "category_order": [
      "Official Anthropic",
      "Claude Code skills",
      "MCP server / tooling",
      "Agent harness",
      "Coding agent CLI",
      "Memory / context",
      "Prompts & system prompts",
      "Spec-driven dev",
      "Awesome list / directory"
    ],
    "other_category_label": "Other",
    "other_max": 10
  },

  "brief": {
    "max_chars": 280,
    "readme_excerpt_max_chars": 320,
    "readme_raw_max_chars": 4000,
    "fetch_readme_when_description_empty": true
  },

  "scope_filter": {
    "require_match": true,
    "any": [
      "claude", "anthropic", "mcp", "model context protocol",
      "model-context-protocol", "claude-code", "claude code", "agentic",
      "coding agent", "coding-agent", "ai agent", "ai-agent", "llm agent",
      "agent skill", "agent framework", "subagent", "codex", "opencode", "openclaw",
      "skill.md", "slash command", "agent harness", "skill", "skills",
      "system prompt", "system prompts", "spec-driven", "spec-kit", "spec kit",
      "ai harness", "agency-agents", "ai agency", "bmad", "agile ai",
      "agent-memory", "ai-memory"
    ]
  },

  "discovery": {
    "repo_search_queries": [
      "topic:claude-code",
      "topic:claude-skills",
      "topic:claude-agent",
      "topic:claude",
      "topic:model-context-protocol",
      "topic:spec-driven",
      "claude code in:name,description",
      "claude skill in:name,description",
      "claude agent in:name,description",
      "mcp server in:name,description",
      "claude-code in:name,description",
      "coding agent cli in:name,description",
      "opencode in:name,description",
      "openhands in:name,description",
      "spec-driven development in:name,description",
      "agency-agents in:name,description",
      "agent skills in:name,description",
      "claude plugin in:name,description",
      "topic:anthropic",
      "prompt engineering in:name,description",
      "ai harness in:name,description",
      "claude in:name",
      "bmad in:name,description",
      "ai memory in:name,description",
      "topic:mcp",
      "topic:mcp-server",
      "model context protocol in:name,description",
      "topic:openclaw",
      "openclaw in:name,description"
    ],
    "code_search_filenames": [
      "SKILL.md",
      "CLAUDE.md"
    ],
    "awesome_lists": [
      {
        "repo": "hesreallyhim/awesome-claude-code",
        "path": "data/repo-ticker.csv",
        "owner_repo_col": 0,
        "skip_header": true
      }
    ]
  },

  "alias_map": {
    "All-Hands-AI/OpenHands": "OpenHands/OpenHands",
    "affaan-m/ECC": "affaan-m/everything-claude-code",
    "sst/opencode": "anomalyco/opencode",
    "getAsterisk/claudia": "winfunc/opcode",
    "forrestchang/andrej-karpathy-skills": "multica-ai/andrej-karpathy-skills",
    "ruvnet/claude-flow": "ruvnet/ruflo"
  },

  "denylist": [
    "google-gemini/gemini-cli",
    "openai/codex",
    "sindresorhus/awesome",
    "chatanywhere/GPT_API_free",
    "songquanpeng/one-api",
    "Wei-Shaw/sub2api",
    "voideditor/void",
    "jeecgboot/JeecgBoot",
    "BerriAI/litellm",
    "QuantumNous/new-api",
    "router-for-me/CLIProxyAPI",
    "cheahjs/free-llm-api-resources",
    "Alishahryar1/free-claude-code",
    "tw93/Pake",
    "chatboxai/chatbox",
    "danny-avila/LibreChat",
    "khoj-ai/khoj",
    "labring/FastGPT",
    "asgeirtj/system_prompts_leaks",
    "x1xhlol/system-prompts-and-models-of-ai-tools",
    "CherryHQ/cherry-studio",
    "dyad-sh/dyad",
    "activepieces/activepieces",
    "charmbracelet/crush",
    "QwenLM/qwen-code",
    "openai/symphony",
    "openai/skills",
    "Yeachan-Heo/oh-my-codex",
    "ultraworkers/claw-code",
    "zeroclaw-labs/zeroclaw",
    "n8n-io/n8n",
    "open-webui/open-webui",
    "langgenius/dify",
    "Mintplex-Labs/anything-llm",
    "FlowiseAI/Flowise",
    "ChatGPTNextWeb/NextChat",
    "ToolJet/ToolJet",
    "Budibase/budibase",
    "nocobase/nocobase",
    "1Panel-dev/1Panel",
    "1Panel-dev/MaxKB",
    "coze-dev/coze-studio",
    "warpdotdev/warp",
    "binary-husky/gpt_academic",
    "oobabooga/textgen",
    "mudler/LocalAI",
    "gitroomhq/postiz-app",
    "elder-plinius/CL4R1T4S"
